# Copy to .env and adjust. Everything has a sane default.
POSTGRES_DB=shiftkey
POSTGRES_USER=shiftkey
POSTGRES_PASSWORD=change-me
SHIFTKEY_PORT=8080

# Export file name becomes "<21 October 2026> <suffix>.xlsx"
SHIFTKEY_REPORT_NAME_SUFFIX=Expatriates

# A "Present" record spanning this many hours or more is flagged for review
SHIFTKEY_LONG_SPAN_HOURS=16

# PayCode prefix -> staff segment used for HR scoping
SHIFTKEY_SEGMENT_PREFIXES=1:indian,2:local

# First admin account. Leave the password empty to have one generated and printed
# in `docker compose logs app` on first start (you will be asked to change it).
SHIFTKEY_ADMIN_USERNAME=admin
SHIFTKEY_ADMIN_PASSWORD=

# Set to true once ShiftKey is served over HTTPS (reverse proxy)
SHIFTKEY_SECURE_COOKIES=false
SHIFTKEY_SESSION_HOURS=168

# Encrypts stored SQL connection passwords. Any long random string. If left empty a key is
# generated once and kept in the appdata volume (/srv/data/secret.key) – back it up.
SHIFTKEY_SECRET_KEY=
